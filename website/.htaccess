# The admin shell and its native ES modules have no content-hashed names yet.
# Revalidate them on every use so a release is picked up without a hard refresh.
# Only switch to immutable/long-lived caching together with hashed filenames.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
        # A hosting-level mod_expires may add a future Expires; no-cache wins,
        # but removing it keeps proxies from making the opposite assumption.
        Header unset Expires
    </FilesMatch>
</IfModule>

# The API authenticates via "Authorization: Bearer <jwt>". Apache drops that header
# for php-fpm/CGI unless it is passed through explicitly; php -S and mod_php are
# unaffected. The router also reads REDIRECT_HTTP_AUTHORIZATION and the parsed
# headers, so every SAPI is covered.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
</IfModule>

# 404 Error Document
ErrorDocument 404 /404.html
