# Example Nginx configuration for Jaco CMS. Nginx ignores .htaccess files,
# so the Apache hardening shipped in jaco/ does nothing here: copy the
# location blocks below into the server context of the site.
#
# Jaco lives entirely in the web root: static .html pages next to jaco/
# (admin panel + api.php) and media/ (editor images and PDFs).

server {
    # ... server_name, root, listen directives ...

    # Public-site 404. Keep the response status 404 and do not expose the
    # error page as a directly editable/normal 200 URL.
    error_page 404 /404.html;
    location = /404.html {
        internal;
    }

    # The API authenticates via "Authorization: Bearer <jwt>": without this
    # line PHP never sees the header and every authenticated call answers 403.
    location ~ \.php$ {
        # ... fastcgi_pass, fastcgi_index, include fastcgi_params ...
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    }

    # Crawler entry points stay reachable and are never redirected.
    location = /robots.txt  { try_files $uri =404; }
    location = /sitemap.xml { try_files $uri =404; }

    # The admin shell and its ES modules are not content-hashed yet: make the
    # browser revalidate them so a release is picked up without a hard refresh.
    # `^~` below makes the /jaco/ prefix win over this regex, so repeat the
    # no-cache header inside the frontend block.
    location ~* \.(html|css|js)$ {
        # Do not inherit a server-level expires setting.
        expires off;
        add_header Cache-Control "no-cache, must-revalidate" always;
    }

    # jaco/ as a whitelist: the API entry point, the admin shell and the
    # frontend assets. The nested locations win over the parent block, so the
    # inner deny also covers files that nobody listed.
    # Keep search engines out of the admin area.
    location ^~ /jaco/ {
        add_header X-Robots-Tag "noindex, nofollow" always;
        location = /jaco/api.php    { }
        location = /jaco/index.html { }
        location ^~ /jaco/frontend/ {
            location ~* \.(js|mjs|css)$ {
                try_files $uri =404;
                expires off;
                add_header Cache-Control "no-cache, must-revalidate" always;
            }
            location / { deny all; }
        }
        location / { deny all; }
    }

    location ^~ /jaco-data/      { deny all; }
    location ^~ /jaco/runtime/   { deny all; }

    # Editor uploads: serve, never execute PHP through them.
    location ~ ^/media/.*\.ph(p|ar|tml|t|ps)$ { deny all; }

    # Behind a reverse proxy also forward the header:
    # proxy_set_header Authorization $http_authorization;
}
