# Jaco application directory. Only two files and the admin shell are public,
# everything else is denied - including files that nobody listed here.
# This file must not enable the rewrite engine: the Authorization forwarding
# for /jaco/api.php lives in the root .htaccess and child rewrite rules would
# override it.
Options -Indexes

# The API entry point and the admin shell.
<FilesMatch "^(api\.php|index\.html)$">
    Require all granted
</FilesMatch>

# Everything else in this directory is internal. jaco/frontend/ overrides this
# with its own list; the other subdirectories carry their own deny file.
Require all denied
