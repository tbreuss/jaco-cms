# Jaco application directory. Only the API entry point and the admin shell are
# public, everything else is denied - including files that nobody listed here.
# This file must not enable the rewrite engine: the Authorization forwarding
# for /jaco/api.php lives in the root .htaccess and child rewrite rules would
# override it.
Options -Indexes

# Everything is internal. The two public entry points are granted afterwards:
# while this file is evaluated the requested name is not known yet, so the
# order of the sections decides. A deny that comes last would win for them too.
Require all denied

<FilesMatch "^(api\.php|index\.html)$">
    Require all granted
</FilesMatch>
