{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "checks": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "label": {
                        "type": "string"
                    },
                    "ok": {
                        "type": "boolean"
                    },
                    "detail": {
                        "type": "string"
                    }
                },
                "required": [
                    "label",
                    "ok",
                    "detail"
                ],
                "additionalProperties": false
            }
        },
        "config": {
            "type": "object"
        },
        "overview": {
            "type": "object",
            "properties": {
                "pages": {
                    "type": "integer"
                },
                "uploads": {
                    "type": "integer"
                },
                "backups": {
                    "type": "integer"
                },
                "projectSize": {
                    "type": "integer"
                },
                "logSize": {
                    "type": "integer"
                },
                "logLines": {
                    "type": "integer"
                }
            },
            "required": [
                "pages",
                "uploads",
                "backups",
                "projectSize",
                "logSize",
                "logLines"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "checks",
        "config",
        "overview"
    ],
    "additionalProperties": false
}
