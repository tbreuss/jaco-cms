{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "items": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "content": {
                        "type": "null"
                    },
                    "created": {
                        "type": "integer"
                    },
                    "extension": {
                        "type": "string"
                    },
                    "file": {
                        "type": "string"
                    },
                    "size": {
                        "type": "integer"
                    }
                },
                "required": [
                    "content",
                    "created",
                    "extension",
                    "file",
                    "size"
                ]
            }
        },
        "filter": {
            "type": "string"
        },
        "sort": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "minItems": 2,
            "maxItems": 2
        }
    },
    "required": [
        "items",
        "filter",
        "sort"
    ]
}
