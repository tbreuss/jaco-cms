{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "srcFile": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128,
            "pattern": "[A-Za-z0-9-_/]"
        },
        "dstFile": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128,
            "pattern": "[A-Za-z0-9-_]",
            "$error": {
                "_pattern": "huhu, thats wrong"
            }
        },
        "dstTitle": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        }
    },
    "required": ["srcFile", "dstFile", "dstTitle"],
    "additionalProperties": false
}
