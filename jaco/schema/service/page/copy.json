{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "srcFileName": {
            "type": "string",
            "default": "",
            "minLength": 4,
            "maxLength": 128,
            "_pattern": "[A-Za-z0-9-_\/]",
            "_$error": {
                "pattern": "huhu, thats wrong"
            }
        },
        "dstFileName": {
            "type": "string",
            "default": "",
            "minLength": 4,
            "maxLength": 128,
            "_pattern": "[A-Za-z0-9-_\/]",
            "_$error": {
                "pattern": "huhu, thats wrong"
            }
        },
        "dstPageTitle": {
            "type": "string",
            "default": "",
            "minLength": 1,
            "maxLength": 128
        }
    },
    "required": ["srcFileName", "dstFileName", "dstPageTitle"],
    "additionalProperties": false
}
