{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "file": {"type": "string"},
        "name": {"type": "string"},
        "created": {"type": "integer"},
        "content": {"type": "string"},
        "appliedFiles": {"type": "integer"},
        "appliedElements": {"type": "integer"},
        "failed": {"type": "array", "items": {"type": "string"}}
    },
    "required": ["file", "name", "created", "content", "appliedFiles", "appliedElements", "failed"],
    "additionalProperties": false
}
