parameters:
    bootstrapFiles:
        - vendor/autoload.php
        - constants.php
    ignoreErrors:
        - '#Path in require\(\) "settings.php" is not a file or it does not exist.#'
        - '#with no value type specified in iterable type array.#'
        - '#return type has no value type specified in iterable type array.#'
    level: 6
    paths:
        - backend
        - api.php
        - routes.php
        - autoload.php
        - cli.php
        - constants.php
        - settings.dist.php
    reportUnmatchedIgnoredErrors: false
