includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
parameters:
    bootstrapFiles:
        - vendor/autoload.php
    ignoreErrors:
        - '#with no value type specified in iterable type array.#'
        - '#return type has no value type specified in iterable type array.#'
    level: 8
    paths:
        - backend
        - test
        - api.php
        - autoload.php
        - cli.php
        - install.php
        - routes.php
        - settings.dist.php
    reportUnmatchedIgnoredErrors: true
