parameters:
    bootstrapFiles:
        - vendor/autoload.php
        - constants.php
    ignoreErrors:
        - '#with no value type specified in iterable type array.#'
        - '#return type has no value type specified in iterable type array.#'
    level: 6
    paths:
        - backend
        - api.php
        - autoload.php
        - cli.php
        - constants.php
        - settings.dist.php
        - settings.php
