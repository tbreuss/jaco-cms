{
    "name": "tbreuss/jaco-cms",
    "description": "The CMS that turns static HTML into editable pages",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^6.1",
        "opis/json-schema": "^2.3",
        "adhocore/cli": "^1.6",
        "chillerlan/php-qrcode": "^6.0"
    },
    "autoload": {
        "files": [
            "autoload.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "audit": {
            "ignore": {
                "PKSA-y2cr-5h3j-g3ys": "Accepted low risk, drop after upgrade to firebase/php-jwt v7"
            }
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "deptrac/deptrac": "^4.7",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "protect-vendor": "printf '%s\\n' '# Third-party code: never serve directly.' 'Require all denied' > vendor/.htaccess",
        "post-install-cmd": "@protect-vendor",
        "post-update-cmd": "@protect-vendor",
        "deptrac": "deptrac analyse --config-file=deptrac.yaml --no-progress",
        "coverage": [
            "rm -f test/runtime/coverage.xml",
            "phpunit --coverage-clover=test/runtime/coverage.xml --only-summary-for-coverage-text --do-not-fail-on-phpunit-warning",
            "@php test/coverage-gate.php test/runtime/coverage.xml"
        ],
        "check": [
            "@cs-check",
            "@phpstan",
            "@deptrac",
            "@test"
        ]
    }
}
