# Staging guard: keep search engines out until the site goes live.
#
# The header is sent with every response, so it also covers uploads, PDFs and error
# pages, where a <meta name="robots"> cannot sit. Delete this file (or just the header
# line) when the site goes public – together with the noindex meta tags in the pages.
#
# Needs mod_headers. On nginx this file is ignored; set the header there instead:
#     add_header X-Robots-Tag "noindex, nofollow" always;

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>

# The admin shell and its native ES modules have no content-hashed names yet.
# Revalidate them on every use so a release is picked up without a hard refresh.
# Only switch to immutable/long-lived caching together with hashed filenames.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# The API authenticates via "Authorization: Bearer <jwt>". Apache drops that header
# for php-fpm/CGI unless it is passed through explicitly; php -S and mod_php are
# unaffected. The router also reads REDIRECT_HTTP_AUTHORIZATION and the parsed
# headers, so every SAPI is covered.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
</IfModule>
